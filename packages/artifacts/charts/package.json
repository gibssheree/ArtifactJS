{
  "name": "@interactive-artifact/charts",
  "version": "0.1.0",
  "description": "Interactive data visualization capability supporting bar, line, pie, and scatter charts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@interactive-artifact/protocol": "workspace:*",
    "@interactive-artifact/core": "workspace:*",
    "@interactive-artifact/registry": "workspace:*",
    "@interactive-artifact/renderer-svg": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
